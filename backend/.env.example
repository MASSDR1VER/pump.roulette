# PumpRoulette Backend Configuration
# Copy this file to .env and update the values

# Application settings
APP_NAME=PumpRoulette
VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/pumproulette
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Pump.fun API
PUMP_FUN_API_URL=https://api.pump.fun
PUMP_FUN_API_KEY=your-api-key-here
PUMP_FUN_STREAM_ENDPOINT=/v1/streams/live
PUMP_FUN_REFRESH_INTERVAL=30

# WebSocket
WEBSOCKET_MESSAGE_LIMIT=500
WEBSOCKET_RATE_LIMIT=10
WEBSOCKET_MAX_CONNECTIONS=1000

# Chat moderation
ENABLE_CHAT_MODERATION=True
MAX_CHAT_HISTORY=100

# Wallet integration
SUPPORTED_WALLETS=["phantom","metamask","walletconnect"]
REQUIRE_WALLET_FOR_CHAT=False

# LiveKit Configuration (Required for Audio Rooms)
# Option 1: Use LiveKit Cloud (Recommended for production)
# Get your free account at: https://cloud.livekit.io
# Create an API key and secret from the dashboard
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Option 2: Use Local LiveKit Server (For development)
# Run: docker run --rm -p 7880:7880 livekit/livekit-server --dev
# Then use these settings:
# LIVEKIT_URL=wss://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Option 3: Self-hosted LiveKit Server
# Deploy LiveKit on your infrastructure and configure accordingly
# LIVEKIT_URL=wss://your-livekit-server.com
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pumproulette.log

# Stream pairing
MIN_ACTIVE_STREAMS=2
STREAM_PAIR_CACHE_TTL=60

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60