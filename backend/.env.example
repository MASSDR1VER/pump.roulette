# PumpRoulette Backend Configuration
# Copy this file to .env and update the values

# Application settings
APP_NAME=PumpRoulette
VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/pumproulette
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Pump.fun API
PUMP_FUN_API_URL=https://api.pump.fun
PUMP_FUN_API_KEY=your-api-key-here
PUMP_FUN_STREAM_ENDPOINT=/v1/streams/live
PUMP_FUN_REFRESH_INTERVAL=30

# WebSocket
WEBSOCKET_MESSAGE_LIMIT=500
WEBSOCKET_RATE_LIMIT=10
WEBSOCKET_MAX_CONNECTIONS=1000

# Chat moderation
ENABLE_CHAT_MODERATION=True
MAX_CHAT_HISTORY=100

# Wallet integration
SUPPORTED_WALLETS=["phantom","metamask","walletconnect"]
REQUIRE_WALLET_FOR_CHAT=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pumproulette.log

# Stream pairing
MIN_ACTIVE_STREAMS=2
STREAM_PAIR_CACHE_TTL=60

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60